# ==============================================================================
# Git Ignore for PHP / Laravel & Web Development Project
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BẢO MẬT & BIẾN MÔI TRƯỜNG (Sensitive & Environment Files)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
/auth.json
**/auth.json
Homestead.json
Homestead.yaml

# File cấu hình kết nối DB cục bộ có mật khẩu
ConnectionDB.local.php
config.local.php

# File cơ sở dữ liệu & dumps (Database dumps & SQLite files)
*.sql
*.sqlite
*.sqlite-journal
*.db
*.dump

# ------------------------------------------------------------------------------
# 2. THƯ VIỆN & DEPENDENCIES (Package Managers - Rất nặng, không commit)
# ------------------------------------------------------------------------------
/vendor/
**/vendor/
/node_modules/
**/node_modules/
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*
/pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. LARAVEL & BUILD ARTIFACTS (Cache, Session, Logs, Vite/Mix builds)
# ------------------------------------------------------------------------------
*.log
/storage/*.key
/storage/pail
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# Vite & Frontend build
/public/build
/public/hot
/public/storage
dist/
build/

# ------------------------------------------------------------------------------
# 4. HÌNH ẢNH & UPLOADS (Images & Media Files - Không commit ảnh)
# ------------------------------------------------------------------------------
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.avif
*.tiff
public/uploads/
**/uploads/

# ------------------------------------------------------------------------------
# 4. TESTING & CODE QUALITY
# ------------------------------------------------------------------------------
.phpunit.result.cache
/.phpunit.cache
.phpactor.json

# ------------------------------------------------------------------------------
# 5. IDE, EDITOR & AI ASSISTANT CONFIGURATIONS (Chứa đường dẫn cá nhân)
# ------------------------------------------------------------------------------
.vscode/
.idea/
.fleet/
.nova/
.zed/
*.sublime-workspace
*.sublime-project

# Cấu hình AI tool local
.claude/
.codex/
.impeccable/
.gemini/
*.local.json

# ------------------------------------------------------------------------------
# 6. HỆ ĐIỀU HÀNH & FILE TẠM (OS & Temporary files)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Backup / Swap
*.bak
*.tmp
*.temp
*.swp
*.swo
*~
